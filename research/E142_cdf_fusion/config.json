{
  "experiment": "E142_cdf_fusion",
  "purpose": "E141 showed score-level fusion blows up because some DINOv2 views have a huge Train->Test score shift (A_DINOcorr: S1 rejection 1.0, S2 acceptance 0.0). Fix: map every view's score through its own Train out-of-fold empirical CDF (per task). That transform is monotone, bounded in [0,1], and uses Train statistics only, so fusion can no longer be destroyed by one shifted view. Objective: W = 0.25*LOSO + 0.25*S1 + 0.5*S2 > 0.80.",
  "data": {
    "train_metadata": "BrainPrint_cache/train_metadata.csv",
    "test_metadata": "BrainPrint_cache/test_metadata.csv"
  },
  "views": {
    "B_E65logspd": ["BrainPrint_cache/e65_correlation_spd/train_correlation_logspd.npy",
                    "research/E121_pca_sweep/test_logspd.npy"],
    "A_E62corr8": ["BrainPrint_cache/e62_multiwindow/train_multiwindow_corr8_dinov2.npy",
                   "BrainPrint_cache/e62_multiwindow/test_multiwindow_corr8_dinov2.npy"],
    "A_E62cov4": ["BrainPrint_cache/e62_multiwindow/train_multiwindow_cov4_dinov2.npy",
                  "BrainPrint_cache/e62_multiwindow/test_multiwindow_cov4_dinov2.npy"],
    "A_E62cov8": ["BrainPrint_cache/e62_multiwindow/train_multiwindow_cov8_dinov2.npy",
                  "BrainPrint_cache/e62_multiwindow/test_multiwindow_cov8_dinov2.npy"],
    "A_DINOcorr": ["BrainPrint_cache/eeg_image_dinov2/train_correlation_dinov2.npy",
                   "BrainPrint_cache/eeg_image_dinov2/test_correlation_dinov2.npy"],
    "A_DINOcov5": ["BrainPrint_cache/eeg_image_dinov2/train_covariance5_dinov2.npy",
                   "BrainPrint_cache/eeg_image_dinov2/test_covariance5_dinov2.npy"],
    "A_DINOcovHR": ["BrainPrint_cache/eeg_image_dinov2/train_covariance_hr_dinov2.npy",
                    "BrainPrint_cache/eeg_image_dinov2/test_covariance_hr_dinov2.npy"],
    "A_DINOtope5": ["BrainPrint_cache/eeg_image_dinov2/train_topomap5_dinov2.npy",
                    "BrainPrint_cache/eeg_image_dinov2/test_topomap5_dinov2.npy"],
    "N_E21corrf": ["BrainPrint_cache/e21_scale_invariant/train_corr_fisher_zband.npy",
                   "BrainPrint_cache/e21_scale_invariant/test_corr_fisher_zband.npy"],
    "N_E21covdz": ["BrainPrint_cache/e21_scale_invariant/train_cov_detrend_zband.npy",
                   "BrainPrint_cache/e21_scale_invariant/test_cov_detrend_zband.npy"]
  },
  "sets": {
    "routeB_only": ["B_E65logspd"],
    "routeA_only": ["A_E62corr8", "A_E62cov4", "A_E62cov8", "A_DINOcorr", "A_DINOcov5",
                    "A_DINOcovHR", "A_DINOtope5"],
    "B_plus_A": ["B_E65logspd", "A_E62corr8", "A_E62cov4", "A_E62cov8", "A_DINOcorr",
                 "A_DINOcov5", "A_DINOcovHR", "A_DINOtope5"],
    "B_plus_A_plus_N": ["B_E65logspd", "A_E62corr8", "A_E62cov4", "A_E62cov8", "A_DINOcorr",
                        "A_DINOcov5", "A_DINOcovHR", "A_DINOtope5", "N_E21corrf", "N_E21covdz"],
    "B_plus_cleanA": ["B_E65logspd", "A_E62corr8", "A_E62cov4", "A_E62cov8",
                      "A_DINOcov5", "A_DINOcovHR"]
  },
  "tasks": ["EC", "EO", "Imagery", "SSVEP"],
  "pca_dim": 96,
  "prototype_k": 32,
  "fit_fraction": 0.6,
  "acceptance_grid": [0.90, 0.92, 0.94, 0.95, 0.96, 0.97, 0.98, 0.99],
  "weights": {"LOSO": 0.25, "S1": 0.25, "S2": 0.5},
  "targets": {"weighted": 0.80}
}
