{
  "experiment": "E85 unified project Test CSV generation and post-write audit",
  "input": {
    "template": "Brainprint_Competition/test.csv",
    "metadata": "BrainPrint_cache/test_metadata.csv",
    "expected_rows": 22251,
    "label_range": [0, 20]
  },
  "decision": {
    "inference_uses_session": false,
    "inference_uses_sample_order": false,
    "inference_uses_test_labels": false,
    "post_write_audit_only": true
