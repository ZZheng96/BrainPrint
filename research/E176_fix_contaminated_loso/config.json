  },
  "protocol": {
    "loso": "leave-one-identity-out，20 折；原型只用 pm & (frac<=0.6)",
    "threshold_rule": "阈值 = 该折 known 块分数的 1-a 分位",
    "test_threshold": "各实验原始 Train-only 参考分布（Train OOF / 参考块）的 1-a 分位",
    "acceptance_grid": [0.80, 0.85, 0.88, 0.90, 0.91, 0.92, 0.93, 0.94, 0.95, 0.96],
    "weights": {"LOSO": 0.25, "Test_S1": 0.25, "Test_S2": 0.5},
    "checks": {
      "test_reproduction_tolerance": 0.005,
      "loso_reproduction_tolerance": 0.005,
      "rule": "Test S1/S2 或污染 LOSO 复现失败 -> pipeline_mismatch，停止该配置"
    }
  },
  "experiments": [
