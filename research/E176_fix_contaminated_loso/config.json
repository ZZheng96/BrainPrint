    {"name": "E141_weighted_image_route", "config": "score:B_E65logspd，k=32，per-task z", "recorded_a": 0.97, "recorded_W": 0.7796},
    {"name": "E138_scale_free_score", "config": "form=d1，k=3，PCA96", "recorded_a": 0.95, "recorded_W": 0.7399},
    {"name": "E137_multi_view", "config": "greedy=E21_covdz_k3+E65_logspd_k3", "recorded_a": 0.90, "recorded_W": 0.6977},
    {"name": "E140_metric_learning", "config": "PCA128_raw_control，k=3，fit 原型", "recorded_a": 0.90, "recorded_W": 0.6561},
    {"name": "E136_clean_three_way", "config": "P96_k3", "recorded_a": 0.95, "recorded_W": 0.6431},
    {"name": "E133_mean_objective", "config": "G_global（k=1 均值原型）", "recorded_a": 0.85, "recorded_W": "N/A（原实验无 S1）"},
    {"name": "E119_score_battery", "config": "纯 Test 诊断分数电池", "recorded_a": "N/A", "recorded_W": "N/A"}
