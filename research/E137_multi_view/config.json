                   "research/E121_pca_sweep/test_logspd.npy"],
    "E21_corrfisher": ["BrainPrint_cache/e21_scale_invariant/train_corr_fisher_zband.npy",
                       "BrainPrint_cache/e21_scale_invariant/test_corr_fisher_zband.npy"],
    "E21_covdz": ["BrainPrint_cache/e21_scale_invariant/train_cov_detrend_zband.npy",
                  "BrainPrint_cache/e21_scale_invariant/test_cov_detrend_zband.npy"],
    "E62_corr8": ["BrainPrint_cache/e62_multiwindow/train_multiwindow_corr8_dinov2.npy",
                  "BrainPrint_cache/e62_multiwindow/test_multiwindow_corr8_dinov2.npy"],
    "E62_cov4": ["BrainPrint_cache/e62_multiwindow/train_multiwindow_cov4_dinov2.npy",
                 "BrainPrint_cache/e62_multiwindow/test_multiwindow_cov4_dinov2.npy"],
    "E62_cov8": ["BrainPrint_cache/e62_multiwindow/train_multiwindow_cov8_dinov2.npy",
