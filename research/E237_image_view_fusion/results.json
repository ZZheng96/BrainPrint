    "metrics": {
      "separation_auc": "S2-vs-S1 AUC of the fused Test score (ties handled by mid-rank).",
      "loso_gate": "tau = 10th percentile of the pooled LOSO unknown fused scores, i.e. LOSO unknown rejection = 0.90 (the compliant operating point); read Test S1 rejection and S2 acceptance there.",
      "s1_gate_095": "tau = 95th percentile of the fused Test S1 scores; read S2 acceptance (official gate).",
      "fold_s2_proxy": "per-fold acceptance of the enrolled (known) rows with trial fraction in (0.6,0.8] at the LOSO=0.90 tau; mean +- std over the 20 folds.",
      "purity": {
        "space": "frozen E233 baseline EEG PCA space (no alignment), k-means k=20, seed 20261117+20, 60 Lloyd iterations on all 19218 Test session2 rows; the partition is identical for every candidate",
        "reported": "purity over the accepted S2 rows at the candidate's tau, using the EEG-branch predicted identity (the fused score is scalar, it carries no identity head)",
        "baseline_definition": "the same quantity for the EEG-only candidate at its own LOSO=0.90 tau"
      },
      "coverage": "number of distinct identities among the accepted Test rows"
    },
    "decision_rule": {
      "valid": "S2 at the S1>=0.95 gate > 0.706 AND separation AUC > 0.8795 AND accepted-row purity >= 0.95 x baseline purity",
      "separable_only": "separation AUC rises but S2 at the S1>=0.95 gate does not -> report 'the separability gain did not translate into the operating point' and explain why",
      "fail": "every candidate is worse than the baseline -> state that fusing image views with the aligned EEG score gives no gain, with the evidence"
    },
    "limitations": [
      "Only 7 image types have both Train and Test caches; GAF / MTF / spectrogram / DINOv3 exist only for Train and cannot be used.",
      "Test has no identity labels: official C / RA / ASafeR are N/A; S1 rejection and S2 acceptance are the only read-outs.",
      "Test has been inspected repeatedly since E65, so every S2 number carries a repeated-inspection bias; four fusion weights and all thresholds are fixed in this file before the run.",
      "E232 showed session and registration status are confounded (S1 = 5 unregistered subjects, S2 = 20 enrolled users); alignment uses session only as a batch key.",
      "The mean alignment is batch/transductive: it estimates an unlabelled statistic on the batch that is being scored, which needs confirmation against the competition rules.",
      "The fused score is scalar; identity still comes from the EEG branch, so purity/coverage only measure whether the fused accept decision keeps coherent identities."
    ]
  },
