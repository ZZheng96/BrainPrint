{
  "experiment": "E161_raw_eeg_contrastive",
  "purpose": "Train a cross-session identity representation end-to-end on raw 18x1200 EEG with supervised contrastive learning, then plug it into the unchanged E143 open-set protocol. Test diagnostic AUC must beat 0.7578 and W must beat 0.6958.",
  "data": {
    "train_metadata": "BrainPrint_cache/train_metadata.csv",
    "test_metadata": "BrainPrint_cache/test_metadata.csv",
    "train_root": "Brainprint_Competition",
    "channels": 18,
    "samples_per_trial": 1200,
    "sampling_rate_hz": 300,
    "train_trials": 11304,
    "test_rows": 22251,
    "session_train": "session1"
  },
  "encoder": {
    "widths": [32, 64, 96, 128],
    "kernels": [7, 7, 5, 5],
    "strides": [2, 2, 2, 2],
    "embed_dim": 128,
    "dropout": 0.1,
    "pooling": "concat(global_mean, global_max)",
    "output": "L2 normalised",
    "normalisation": "per-trial per-channel mean removal, then division by the per-trial global RMS (fixed, no batch statistics)",
    "param_budget": 1000000
  },
  "train": {
    "seed": 20261115,
    "epochs": 40,
    "steps_per_epoch": 150,
    "subjects_per_batch": 20,
    "trials_per_subject": 2,
    "views_per_trial": 2,
    "temperature": 0.1,
    "loss": "supervised contrastive (SupCon) over within-task identity labels",
    "lr": 0.001,
    "weight_decay": 0.0001,
    "warmup_steps": 200,
    "schedule": "cosine",
    "grad_clip": 5.0,
    "early_stop_patience": 8,
    "fit_fraction": 0.6,
    "eval_fraction": 0.8,
    "valid_metric": "mean per-task leave-half-out nearest-centroid identity accuracy on the 0.6<frac<=0.8 block (Train only)"
  },
  "augment": {
    "channel_dropout_p": 0.1,
    "time_occlusion_segments": [2, 3],
    "time_occlusion_len": 100,
    "per_channel_gain": [0.8, 1.2],
    "additive_snr_db": [20, 30],
    "time_shift_samples": 50
  },
  "protocol": {
    "tasks": ["EC", "EO", "Imagery", "SSVEP"],
    "pca_dims": [32, 64, 96],
    "prototype_k": [1, 3, 6, 12],
    "fit_fraction": 0.6,
    "blocks": 5,
    "acceptance_grid": [0.80, 0.85, 0.88, 0.90, 0.91, 0.92, 0.93, 0.94, 0.95, 0.96],
    "reference_acceptance": 0.90,
    "weights": {"LOSO": 0.25, "S1": 0.25, "S2": 0.5},
    "loso_known_block": "0.6 < frac <= 0.8, prototypes from fit_rows (frac <= 0.6) of the 19 enrolled identities",
    "loso_unknown_block": "0.6 < frac <= 0.8 of the held-out identity",
    "threshold": "5-block Train OOF score quantile at each acceptance rate; LOSO uses per-fold known-block quantile"
  },
  "control": {
    "name": "E65_correlation_logspd",
    "train_features": "BrainPrint_cache/e65_correlation_spd/train_correlation_logspd.npy",
    "test_features": "research/E121_pca_sweep/test_logspd.npy",
    "reproduction_target": {"pca_dim": 96, "k": 12, "acceptance_rate": 0.9, "W": 0.6958}
  },
  "baseline": {
    "name": "E143_k_sweep_nearest",
    "diagnostic_auc": 0.7578,
    "LOSO_rejection": 0.7936,
    "Test_S1_rejection": 0.7979,
    "Test_S2_acceptance": 0.596,
    "W": 0.6958
  },
  "reporting": {
    "test_official": "N/A: Test has no public labels; session is used only for the diagnostic AUC after scoring"
  }
}
