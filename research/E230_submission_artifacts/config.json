{
  "experiment": "E230_submission_artifacts",
  "purpose": "Load the frozen E228 deploy model only, predict the 22251 Test trials in original metadata order, and emit official-format test.csv plus an auditable detailed CSV. No retraining, no threshold change, no Test-side statistics.",
  "frozen_model": "research/E228_constrained_maxS2/models/deploy_frozen.pt",
  "frozen_candidate": "e226_auc2W",
  "model_source": "E227 frozen deploy_auc2_lofo.pt (block-weighted representation), re-frozen by E228 as deploy_frozen.pt",
  "threshold": {
    "tau": -24.138366795919048,
    "A": 0.8049854437115825,
    "rule": "reject if score < tau; otherwise output nearest-prototype identity (1-20)"
  },
  "representation": {
    "pca_dim": 96,
    "prototypes_k": 12,
    "input_dim": 1569,
    "block_order": [
      "corr_logspd",
      "bandpower_gainfree",
      "spectral_shape",
      "spectral_slope",
      "pac",
      "trial_energy",
      "hjorth",
      "spec_entropy",
      "power_ratio",
      "graph_metrics"
    ],
    "block_dims": {
      "corr_logspd": 855,
      "bandpower_gainfree": 90,
      "spectral_shape": 90,
      "spectral_slope": 18,
      "pac": 18,
      "trial_energy": 1,
      "hjorth": 180,
      "spec_entropy": 180,
      "power_ratio": 112,
      "graph_metrics": 25
    },
    "block_weights_sqrt_applied_before_pca": [
      1.8723500967025757,
      1.3899229764938354,
      1.1489406824111938,
      0.9140388369560242,
      0.5668210983276367,
      0.591008186340332,
      0.8123737573623657,
      0.6581529974937439,
      1.3086190223693848,
      0.7377724647521973
    ],
    "pipeline": "task-wise z-score (Train fit rows) -> multiply sqrt(block weight) -> subtract fit-row mean -> PCA 96 -> nearest of 12 k-means prototypes per (task, identity) -> score = -min Euclidean distance"
  },
  "feature_paths": {
    "train": {
      "corr_logspd": "BrainPrint_cache/e65_correlation_spd/train_correlation_logspd.npy",
