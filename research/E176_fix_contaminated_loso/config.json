{
  "experiment": "E176_fix_contaminated_loso",
  "purpose": "E119/E133/E136/E137/E138/E139/E140/E141/E142 的 LOSO 实现把 19 个注册身份的评估块（0.6<frac<=0.8）也拿去建了原型，导致被测 trial 出现在自己的原型里、known 距离趋近 0、阈值被抬高、LOSO 拒识虚高到 0.95-1.00。本实验按各实验原始配置重建分数管线，复现 Test S1/S2 与污染 LOSO 后，只用 fit 块（frac<=0.6）重建原型重算 LOSO，并给出修正后的 W。",
  "bug": {
    "wrong": "p2, k2 = build_prototypes(a, subjects, tasks, pm, enrolled, k)",
    "correct": "p2, k2 = build_prototypes(a, subjects, tasks, pm & fit_rows, enrolled, k)",
    "scope": "只影响 LOSO（Train 侧）；Test S1/S2 从未进入原型集合"
  },
  "data": {
    "train_metadata": "BrainPrint_cache/train_metadata.csv",
    "test_metadata": "BrainPrint_cache/test_metadata.csv",
    "fit_block": "frac <= 0.6",
    "known_block": "0.6 < frac <= 0.8，19 个注册身份",
    "unknown_block": "0.6 < frac <= 0.8，留出身份",
    "reused_caches": [
      "BrainPrint_cache/e65_correlation_spd/train_correlation_logspd.npy",
      "research/E121_pca_sweep/test_logspd.npy",
      "BrainPrint_cache/e62_multiwindow/*_dinov2.npy",
      "BrainPrint_cache/eeg_image_dinov2/*_dinov2.npy",
      "BrainPrint_cache/e21_scale_invariant/*.npy",
      "research/E142_cdf_fusion/raw_scores.pkl",
      "research/E137_multi_view/view_scores.pkl"
