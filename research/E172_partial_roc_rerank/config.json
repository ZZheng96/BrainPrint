      "family": "spectral_entropy"
    },
    "pac": {
      "train": "research/E146_phase_features/train_pac.npy",
      "test": "research/E146_phase_features/test_pac.npy",
      "pca_dims": [16, 32],
      "family": "pac"
    },
    "wpli": {
      "train": "research/E146_phase_features/train_wpli.npy",
