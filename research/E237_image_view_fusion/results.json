      ],
      "fit_fraction": 0.6,
      "evaluation_fraction": [
        0.6,
        0.8
      ],
      "inner_blocks": 5,
      "folds": 20,
      "task_standardisation": "per-task mean/std of the fit rows (trial fraction <= 0.6, all 20 identities) applied to Train and Test (E228 rule).",
      "pca_dim": 96,
      "prototypes_k": 12,
      "prototype_init": "random sample init, seed = 17 * identity, 20 Lloyd iterations (E143 harness).",
      "known_reference": "inner 5-block out-of-fold scores of the fit rows (prototypes built on the other 4 blocks); this is the Train-side ECDF reference for the rank transform. Folds are blocks of floor(5 * trial_fraction) clipped to [0,4].",
      "loso": "20 folds, one held-out identity each; prototypes from the enrolled identities' fit rows; unknown = held-out identity rows with trial fraction in (0.6, 0.8], known = enrolled rows in the same window (E227/E233 protocol, verified to reproduce the frozen fold caches row-for-row).",
      "alignment": "E233 mean_align applied in each component's own PCA space: z <- z - mean(z | session, task) + mu_ref(task); mu_ref(task) is the fit-row mean of the task, which is exactly 0 because the PCA basis is centred on the fit rows. One identical rule for both sessions, min_cell_n = 200. Session is only a batch key: it never selects an identity and never gates a sample. LOSO rows are not aligned (they are single-session Train data)."
    },
    "eeg_component": {
      "test_score": "research/E233_delta_estimation/cache/test_v1_mean_align.npz",
