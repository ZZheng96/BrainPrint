{
  "experiment": "E172_partial_roc_rerank",
  "purpose": "E170 showed that global diagnostic AUC is the wrong optimisation target: a higher AUC bought a LOWER Test-S2 acceptance at the fixed working point S1 rejection = 0.80. This run re-ranks every existing cached score by local ROC landmarks (S2_at_S1_080 and the partial AUC over S1 rejection in [0.75,0.95]) instead of by global AUC or by the sweep-max W.",
  "data": {
    "train_metadata": "BrainPrint_cache/train_metadata.csv",
    "test_metadata": "BrainPrint_cache/test_metadata.csv"
  },
  "tasks": ["EC", "EO", "Imagery", "SSVEP"],
  "fit_fraction": 0.6,
  "blocks": 5,
  "prototype_k": [1, 3, 6, 12],
  "reference_acceptance": 0.90,
  "weights": {"LOSO": 0.25, "S1": 0.25, "S2": 0.5},
  "local_metrics": {
    "primary_S1_rejection": 0.80,
    "robust_S1_rejection": [0.75, 0.85, 0.90],
    "partial_auc_range": [0.75, 0.95]
  },
  "streams": {
    "E65_logspd": {
      "train": "BrainPrint_cache/e65_correlation_spd/train_correlation_logspd.npy",
      "test": "research/E121_pca_sweep/test_logspd.npy",
      "pca_dims": [64, 96],
      "family": "E65_correlation_logSPD"
    },
    "logbp": {
