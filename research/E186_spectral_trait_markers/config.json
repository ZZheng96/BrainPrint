{
  "experiment": "E186_spectral_trait_markers",
  "purpose": "Extract the literature-standard cross-session-stable EEG identity features (spectral trait markers: individual alpha peak frequency, peak prominence/width, spectral centroid, aperiodic 1/f slope+intercept, spectral edge) from the raw 18x1200 trials, and test their cross-session (Train session1 -> Test session2) identity discriminability, alone and fused with E65 correlation-logSPD. Objective: S1_rejection + S2_acceptance at the same threshold.",
  "data": {
    "train_metadata": "BrainPrint_cache/train_metadata.csv",
    "test_metadata": "BrainPrint_cache/test_metadata.csv",
    "root": "Brainprint_Competition",
    "sampling_rate_hz": 300,
    "channels": 18,
    "samples_per_trial": 1200
  },
  "spectral": {
    "nperseg": 600,
    "noverlap": 300,
    "n_fft": 2048,
    "freq_resolution_hz": 0.146484375,
    "alpha_band_hz": [7.0, 13.0],
    "centroid_band_hz": [4.0, 30.0],
    "aperiodic_band_hz": [2.0, 40.0],
    "aperiodic_exclude_hz": [[7.0, 13.0], [15.0, 25.0]],
    "edge_band_hz": [1.0, 40.0],
    "edge_fraction": 0.95,
    "irls_iterations": 3,
    "irls_huber": 1.5,
    "chunk": 512
  },
  "feature_layout": {
    "iaf": [0, 18],
    "prominence": [18, 36],
    "width": [36, 54],
    "centroid": [54, 72],
    "aperiodic_slope": [72, 90],
    "aperiodic_intercept": [90, 108],
    "edge95": [108, 126],
    "all": [0, 126]
  },
  "streams": {
    "traits": {
      "train": "research/E186_spectral_trait_markers/train_spectral_traits.npy",
      "test": "research/E186_spectral_trait_markers/test_spectral_traits.npy"
    },
    "E65_logspd": {
      "train": "BrainPrint_cache/e65_correlation_spd/train_correlation_logspd.npy",
      "test": "research/E121_pca_sweep/test_logspd.npy",
      "pca_dims": [96]
    }
  },
  "tasks": ["EC", "EO", "Imagery", "SSVEP"],
  "fit_fraction": 0.6,
  "eval_window": [0.6, 0.8],
  "blocks": 5,
  "pca_dims_requested": [16, 32, 48],
  "prototype_k": [1, 3, 6, 12],
  "acceptance_grid": [0.88, 0.90, 0.92, 0.94, 0.96],
  "fusion": {
    "trait_pca_dims": [16, 32],
    "e65_pca_dim": 96,
    "joint_pca_dims": [96, 128],
    "variant": "block_norm"
  },
  "targets": {
    "e65_reference": {"test_auc": 0.7578, "s1": 0.7979, "s2": 0.5960, "s1_plus_s2": 1.3939},
    "historical_best_s1_plus_s2": 1.4479,
    "goal_s1_plus_s2": 1.50,
    "trait_auc_question": 0.70,
    "trait_auc_floor": 0.65
  }
}
