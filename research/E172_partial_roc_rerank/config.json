      "pca_dims": [16, 32, 48],
      "family": "log_band_power"
    },
    "spectral_entropy": {
      "train": "research/E146_phase_features/train_spectral_entropy.npy",
      "test": "research/E146_phase_features/test_spectral_entropy.npy",
