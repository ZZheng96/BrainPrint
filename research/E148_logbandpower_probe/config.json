                    "research/E121_pca_sweep/test_logspd.npy"],
    "P_logbp": ["research/E146_phase_features/train_log_band_power.npy",
                "research/E146_phase_features/test_log_band_power.npy"],
    "P_pac": ["research/E146_phase_features/train_pac.npy",
              "research/E146_phase_features/test_pac.npy"],
    "P_wpli": ["research/E146_phase_features/train_wpli.npy",
