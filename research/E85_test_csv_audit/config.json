  "gates": {
    "S1": "Session1 rejection rate >= 0.95",
    "S2": "Session2 rejection rate <= 0.02 and acceptance rate >= 0.98"
  },
  "test_metrics": {
    "AUC": "N/A（无Test真实标签）",
    "F1": "N/A（无Test真实标签）",
    "C": "N/A（无Test真实标签）",
    "RA": "N/A（无Test真实标签）",
    "ASafeR": "N/A（无Test真实标签）",
    "U": "N/A（无Test真实标签）",
    "Official_Score": "N/A（无Test真实标签）"
  },
  "compatible_candidates": [
    "E64_e58_test_audit/e64_predictions.csv",
    "E42_submission_candidates/candidate_e36c_rule.csv",
    "E42_submission_candidates/candidate_two_gate_rule.csv"
  ],
  "excluded": ["external E74-E84 22-channel checkpoints"]
}
